<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Renders UILayout's default textures (UILayout.DefaultTextures/SrcTextures) and fonts (Inter) into a sheet and
		manifest in UILayout.DefaultTextures/Textures, which the backends embed. Not committed: run it by hand before
		building and after changing a source image or Program.cs, until image processing is part of the build.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\ImageSheetProcessor\ImageSheetProcessor.csproj" />
	</ItemGroup>
	<Target Name="RunImageProcessor"
			AfterTargets="Build"
			Inputs="Program.cs"
			Outputs="..\DefaultTexturesProcessor\Textures\ImageManifest.xml">
		<Message Text="Running DefaultTexturesProcessor" Importance="High" />
		<Exec Command="dotnet &quot;$(TargetPath)&quot;" />
	</Target>
</Project>
