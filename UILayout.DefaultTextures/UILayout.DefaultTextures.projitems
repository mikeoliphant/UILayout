<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>9f1a46c4-bc4c-46f7-b10a-1719d53a5fd3</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>UILayout.DefaultTextures</Import_RootNamespace>
  </PropertyGroup>
  <!-- The default textures and fonts: a sheet and its manifest, rendered from SrcTextures and Inter by
       DefaultTexturesProcessor -->
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Textures\*.png" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Textures\*.xml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)TextureLoader.cs" />
  </ItemGroup>
</Project>